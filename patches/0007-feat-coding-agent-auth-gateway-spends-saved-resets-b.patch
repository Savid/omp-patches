@@ -0,0 +1,151 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import type {
+	AuthStorage,
+	ResetCreditAccountStatus,
+	ResetCreditRedeemOutcome,
+	ResetCreditTarget,
+	UsageReport,
+} from "@oh-my-pi/pi-ai";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import {
+	type CodexAutoRedeemCoordinator,
+	createCodexAutoRedeemCoordinator,
+} from "@oh-my-pi/pi-coding-agent/session/codex-auto-reset";
+import {
+	createResetSalvage,
+	resetSalvageProviders,
+	startResetSalvage,
+} from "@oh-my-pi/pi-coding-agent/session/reset-salvage";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const HOUR = 3_600_000;
+const DAY = 24 * HOUR;
+const EMAIL = "user@example.com";
+const ACCOUNT_ID = "acct-1";
+const CREDENTIAL_ID = 7;
+
+/** A Codex account whose week is mostly used, holding one saved reset. */
+function codexReport(weeklyUsed: number): UsageReport {
+	const now = Date.now();
+	const scope = { provider: "openai-codex", accountId: ACCOUNT_ID };
+	return {
+		provider: "openai-codex",
+		fetchedAt: now,
+		limits: [
+			{
+				id: "openai-codex:primary",
+				label: "5 Hour",
+				scope,
+				window: { id: "5h", label: "5 Hour", resetsAt: now + 2 * HOUR },
+				amount: { usedFraction: 0.1, unit: "percent" },
+			},
+			{
+				id: "openai-codex:secondary",
+				label: "Weekly",
+				scope,
+				window: { id: "7d", label: "Weekly", resetsAt: now + 3 * DAY },
+				amount: { usedFraction: weeklyUsed, unit: "percent" },
+			},
+		],
+		metadata: { accountId: ACCOUNT_ID, email: EMAIL },
+	};
+}
+
+function creditStatus(expiresInMs: number): ResetCreditAccountStatus {
+	return {
+		provider: "openai-codex",
+		credentialId: CREDENTIAL_ID,
+		accountId: ACCOUNT_ID,
+		email: EMAIL,
+		active: false,
+		availableCount: 1,
+		credits: [{ id: "credit-1", status: "available", expiresAt: new Date(Date.now() + expiresInMs).toISOString() }],
+	};
+}
+
+interface Fake {
+	storage: AuthStorage;
+	redeemed: ResetCreditTarget[];
+}
+
+function fakeStorage(
+	report: UsageReport,
+	status: ResetCreditAccountStatus,
+	outcome: ResetCreditRedeemOutcome = { ok: true, code: "reset", provider: "openai-codex" },
+): Fake {
+	const redeemed: ResetCreditTarget[] = [];
+	const storage = {
+		usage: { reports: async () => [report] },
+		resets: {
+			list: async ({ provider }: { provider?: string }) => (provider === status.provider ? [status] : []),
+			redeem: async ({ target }: { target: ResetCreditTarget }) => {
+				redeemed.push(target);
+				return outcome;
+			},
+		},
+		oauth: { accounts: () => [] },
+	} as unknown as AuthStorage;
+	return { storage, redeemed };
+}
+
+const consenting = (): Settings =>
+	Settings.isolated({ "codexResets.autoRedeem5h": "yes", "codexResets.autoRedeemWeekly": "yes" });
+
+describe("reset salvage", () => {
+	let tempDir: TempDir;
+	let coordinator: CodexAutoRedeemCoordinator;
+
+	beforeEach(() => {
+		tempDir = TempDir.createSync("@pi-reset-salvage-");
+		coordinator = createCodexAutoRedeemCoordinator();
+		coordinator.resetLockPath = `${tempDir.path()}/agent.db`;
+	});
+
+	afterEach(() => {
+		tempDir.removeSync();
+	});
+
+	it("spends a reset about to expire on a well-used window, once", async () => {
+		const fake = fakeStorage(codexReport(0.6), creditStatus(2 * HOUR));
+		const salvage = createResetSalvage({ storage: fake.storage, settings: consenting(), coordinator });
+
+		expect(await salvage.sweep()).toEqual([CREDENTIAL_ID]);
+		expect(fake.redeemed.map(target => target.credentialId)).toEqual([CREDENTIAL_ID]);
+		// The episode is spent: a later sweep does not spend it again.
+		expect(await salvage.sweep()).toEqual([]);
+		expect(fake.redeemed).toHaveLength(1);
+	});
+
+	it("leaves a reset with days to run", async () => {
+		const fake = fakeStorage(codexReport(0.6), creditStatus(2 * DAY));
+		const salvage = createResetSalvage({ storage: fake.storage, settings: consenting(), coordinator });
+
+		expect(await salvage.sweep()).toEqual([]);
+		expect(fake.redeemed).toHaveLength(0);
+	});
+
+	it("never spends without a `yes`, and starts nothing", async () => {
+		const fake = fakeStorage(codexReport(0.6), creditStatus(2 * HOUR));
+		const unset = Settings.isolated({});
+
+		expect(resetSalvageProviders(unset)).toEqual([]);
+		expect(startResetSalvage({ storage: fake.storage, settings: unset, coordinator })).toBeUndefined();
+		expect(await createResetSalvage({ storage: fake.storage, settings: unset, coordinator }).sweep()).toEqual([]);
+		expect(fake.redeemed).toHaveLength(0);
+		expect(resetSalvageProviders(consenting())).toEqual(["openai-codex"]);
+	});
+
+	it("defers a failure that may pass, rather than retrying at once", async () => {
+		const fake = fakeStorage(codexReport(0.6), creditStatus(2 * HOUR), {
+			ok: false,
+			code: "http_503",
+			provider: "openai-codex",
+		});
+		const salvage = createResetSalvage({ storage: fake.storage, settings: consenting(), coordinator });
+
+		expect(await salvage.sweep()).toEqual([]);
+		expect(await salvage.sweep()).toEqual([]);
+		expect(fake.redeemed).toHaveLength(1);
+		expect(coordinator.deferredUntilByKey.size).toBe(1);
+	});
+});
