diff --git a/packages/coding-agent/src/session/reset-salvage.ts b/packages/coding-agent/src/session/reset-salvage.ts
new file mode 100644
index 00000000..b8a45c36
--- /dev/null
+++ b/packages/coding-agent/src/session/reset-salvage.ts
@@ -0,0 +1,222 @@
+/**
+ * Saved-reset salvage for a long-lived broker client such as
+ * `omp auth-gateway serve`, which has no session to run it.
+ *
+ * A Claude or Codex saved reset about to expire unused is spent, under the
+ * consent settings (`claudeResets.*`, `codexResets.*`) and the planners an
+ * interactive session uses. Only the planners' `sweep` trigger runs here: a
+ * reset is spent to salvage it before it expires, never to lift a block, which
+ * is left to the session whose request hit it. A window whose consent is
+ * `unset` is never spent, as in any session that cannot ask.
+ */
+import type { AuthStorage, ResetCreditAccountStatus, ResetCreditRedeemOutcome, UsageReport } from "@oh-my-pi/pi-ai";
+import { logger } from "@oh-my-pi/pi-utils";
+import type { Settings } from "../config/settings";
+import {
+	type ClaudeResetAction,
+	claudeResetStatusesFromReports,
+	planClaudeResetRedemptions,
+} from "./claude-auto-reset";
+import {
+	type CodexAutoRedeemCoordinator,
+	type CodexResetAction,
+	createCodexAutoRedeemCoordinator,
+	isTerminalRedeemOutcome,
+	overlayLiveResetCredits,
+	planCodexResetRedemptions,
+	REDEEM_RETRY_DEFER_MS,
+	resetAccountLockKey,
+	resetPlanSettings,
+	resetWindowMode,
+} from "./codex-auto-reset";
+import { checkCodexBalance, resetLockPath, withResetFence } from "./reset-fence";
+import { cfgClaudeResets, cfgCodexResets, resetWindowModes } from "./settings";
+
+type SalvageProvider = "openai-codex" | "anthropic";
+type SalvageAction = CodexResetAction | ClaudeResetAction;
+
+const PROVIDERS: readonly SalvageProvider[] = ["openai-codex", "anthropic"];
+
+/** How often a sweep runs. The planners' salvage horizon is hours, so minutes are plenty. */
+export const RESET_SALVAGE_INTERVAL_MS = 5 * 60_000;
+
+/** The first sweep waits this long after start, so usage reports are warm. */
+const FIRST_SWEEP_DELAY_MS = 60_000;
+
+export interface ResetSalvageOptions {
+	storage: AuthStorage;
+	settings: Settings;
+	baseUrlResolver?: (provider: string) => string | undefined;
+	/** Attempt state kept across sweeps; a fresh one by default. Tests set its `resetLockPath`. */
+	coordinator?: CodexAutoRedeemCoordinator;
+}
+
+export interface ResetSalvage {
+	/** Plan and spend once. Resolves with the credential ids whose reset was spent. */
+	sweep(signal?: AbortSignal): Promise<number[]>;
+}
+
+/** Providers a headless sweep may spend for: at least one of their windows consents with `yes`. */
+export function resetSalvageProviders(settings: Settings): SalvageProvider[] {
+	return PROVIDERS.filter(provider =>
+		Object.values(resetWindowModes(provider, settings)).some(mode => mode === "yes"),
+	);
+}
+
+export function createResetSalvage(options: ResetSalvageOptions): ResetSalvage {
+	const { storage, settings, baseUrlResolver } = options;
+	const coordinator = options.coordinator ?? createCodexAutoRedeemCoordinator();
+	const listing = (provider: SalvageProvider) =>
+		storage.resets.list({ provider, baseUrlResolver, signal: AbortSignal.timeout(10_000) });
+
+	async function plan(provider: SalvageProvider, reports: UsageReport[]): Promise<SalvageAction[]> {
+		const shared = {
+			nowMs: Date.now(),
+			trigger: "sweep" as const,
+			provider: "",
+			modelId: "",
+			attemptedKeys: coordinator.attemptedKeys,
+			deferredUntilByKey: coordinator.deferredUntilByKey,
+			lastAttemptAtByAccount: coordinator.lastAttemptAtByAccount,
+		};
+		if (provider === "openai-codex") {
+			const statuses = await listing(provider);
+			return planCodexResetRedemptions({
+				...shared,
+				settings: resetPlanSettings(resetWindowModes(provider, settings), cfgCodexResets.get(settings)),
+				identity: undefined,
+				reports: overlayLiveResetCredits(reports, statuses),
+			}).actions;
+		}
+		// Claude finds its candidates in the reports' reset inventory first, so a
+		// sweep with nothing to salvage lists no account upstream.
+		const claude = (statuses: readonly ResetCreditAccountStatus[]) =>
+			planClaudeResetRedemptions({
+				...shared,
+				settings: resetPlanSettings(resetWindowModes(provider, settings), cfgClaudeResets.get(settings)),
+				reports,
+				statuses,
+			}).actions;
+		const candidates = claude(claudeResetStatusesFromReports(storage.oauth.accounts(provider), reports));
+		return candidates.length === 0 ? [] : claude(await listing(provider));
+	}
+
+	/** Spend each action once, fenced against other processes on the same database. */
+	async function spend(provider: SalvageProvider, actions: readonly SalvageAction[]): Promise<number[]> {
+		const spent: number[] = [];
+		for (const action of actions) {
+			if (coordinator.attemptedKeys.has(action.attemptKey)) continue;
+			coordinator.attemptedKeys.add(action.attemptKey);
+			coordinator.lastAttemptAtByAccount.set(action.accountKey, Date.now());
+			const redeem = () =>
+				storage.resets.redeem({ target: action.target, baseUrlResolver, signal: AbortSignal.timeout(15_000) });
+			let outcome: ResetCreditRedeemOutcome | undefined;
+			try {
+				const lockKey = resetAccountLockKey(action.target);
+				outcome = !lockKey
+					? await redeem()
+					: await withResetFence<ResetCreditRedeemOutcome | undefined>(
+							resetLockPath(lockKey, coordinator.resetLockPath),
+							// Another process spent for this account moments ago.
+							async () => undefined,
+							async markedRedeem => {
+								// Claude's redeem rechecks its exact offer; Codex's balance is rechecked here.
+								if (provider === "openai-codex") {
+									const balance = checkCodexBalance(
+										await listing(provider),
+										action.target.credentialId,
+										action.availableCount,
+									);
+									if (balance === "spent") return undefined;
+									if (balance) return { ok: false, code: balance, provider };
+								}
+								return (await markedRedeem(redeem)).outcome;
+							},
+						);
+			} catch (error) {
+				coordinator.attemptedKeys.delete(action.attemptKey);
+				coordinator.deferredUntilByKey.set(action.attemptKey, Date.now() + REDEEM_RETRY_DEFER_MS);
+				logger.warn("reset-salvage: redeem threw, deferred", {
+					provider,
+					account: action.label,
+					error: String(error),
+				});
+				continue;
+			}
+			if (!outcome) continue;
+			if (!isTerminalRedeemOutcome(outcome.code)) {
+				coordinator.attemptedKeys.delete(action.attemptKey);
+				coordinator.deferredUntilByKey.set(action.attemptKey, Date.now() + REDEEM_RETRY_DEFER_MS);
+			}
+			if (outcome.code === "reset") {
+				spent.push(action.target.credentialId);
+				logger.info("reset-salvage: spent a saved reset before it expired", {
+					provider,
+					account: action.label,
+					expiresInMs: action.expiresInMs,
+					window: action.salvageWindow,
+					usedFraction: action.salvageUsedFraction,
+				});
+			} else {
+				logger.warn("reset-salvage: reset not spent", { provider, account: action.label, code: outcome.code });
+			}
+		}
+		return spent;
+	}
+
+	return {
+		async sweep(signal) {
+			const providers = resetSalvageProviders(settings);
+			if (providers.length === 0) return [];
+			const reports = await storage.usage.reports({ baseUrlResolver, signal });
+			if (!reports) return [];
+			const spent: number[] = [];
+			for (const provider of providers) {
+				if (!reports.some(report => report.provider === provider)) continue;
+				try {
+					const modes = resetWindowModes(provider, settings);
+					const consented = (await plan(provider, reports)).filter(
+						action => resetWindowMode(modes, action.window) === "yes",
+					);
+					spent.push(...(await spend(provider, consented)));
+				} catch (error) {
+					logger.warn("reset-salvage: sweep failed", { provider, error: String(error) });
+				}
+			}
+			return spent;
+		},
+	};
+}
+
+/**
+ * Sweep on a timer until stopped. Returns undefined, starting nothing, when no
+ * provider consents; consent is read again on every sweep.
+ */
+export function startResetSalvage(
+	options: ResetSalvageOptions,
+	intervalMs = RESET_SALVAGE_INTERVAL_MS,
+): { stop(): void } | undefined {
+	if (resetSalvageProviders(options.settings).length === 0) return undefined;
+	const salvage = createResetSalvage(options);
+	let running = false;
+	const tick = (): void => {
+		if (running) return;
+		running = true;
+		void salvage
+			.sweep()
+			.catch(error => logger.warn("reset-salvage: sweep failed", { error: String(error) }))
+			.finally(() => {
+				running = false;
+			});
+	};
+	const first = setTimeout(tick, Math.min(FIRST_SWEEP_DELAY_MS, intervalMs));
+	const timer = setInterval(tick, intervalMs);
+	first.unref();
+	timer.unref();
+	return {
+		stop() {
+			clearTimeout(first);
+			clearInterval(timer);
+		},
+	};
+}
