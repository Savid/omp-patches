 }
 
+/**
+ * The message to anchor when a request keeps thinking only in its newest
+ * thinking assistant turn and leaves it out of the turns before, or -1.
+ *
+ * A client may leave out the oldest thinking blocks, as long as it keeps them
+ * out. Each one left out changes every prefix after it, so the next request,
+ * which leaves out this turn's thinking too, repeats neither the tail nor the
+ * newest assistant turn where the rolling anchors sit, and reads nothing past
+ * the head. The message before the newest turn that keeps thinking is the last
+ * one whose prefix the next request repeats.
+ *
+ * Such a request holds thinking in exactly one assistant turn, with an earlier
+ * assistant turn holding none. A conversation that keeps every block takes
+ * that shape only while one turn has thought, and the anchor then falls on a
+ * message an earlier request already anchored as its tail.
+ */
+function leftOutThinkingAnchor(messages: readonly MessageParam[], end: number): number {
+	let kept = -1;
+	let leftOut = false;
+	for (let index = end; index >= 0; index--) {
+		const message = messages[index];
+		if (message?.role !== "assistant") continue;
+		const thinks =
+			Array.isArray(message.content) &&
+			message.content.some(block => block.type === "thinking" || block.type === "redacted_thinking");
+		if (!thinks) {
+			if (kept !== -1) leftOut = true;
+		} else if (kept === -1) {
+			kept = index;
+		} else {
+			return -1;
+		}
+	}
+	if (!leftOut) return -1;
+	for (let index = kept - 1; index >= 0; index--) {
+		const message = messages[index];
+		if (!message || isToolControlMessage(message)) continue;
+		if (message.clear_at === "next_user_message" || isPerCallContextMessage(message)) continue;
+		return index;
+	}
+	return -1;
+}
+
 function applyPromptCaching(params: MessageCreateParamsStreaming, cacheControl?: AnthropicCacheControl): void {
 	if (!cacheControl) return;
 
