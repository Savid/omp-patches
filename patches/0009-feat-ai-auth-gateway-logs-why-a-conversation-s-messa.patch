--- /dev/null
+++ b/packages/ai/test/anthropic-message-thread-decisions.test.ts
@@ -0,0 +1,105 @@
+/**
+ * Why a message-thread turn continues or starts over. A create uploads the
+ * whole conversation and cannot read the cache its thread's continues wrote,
+ * so the provider logs each turn's decision with its reason: the evidence that
+ * ties a cache-write spike on a long conversation to its cause.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+	type AnthropicThreadChains,
+	AnthropicThreadTurn,
+	anthropicThreadChain,
+} from "@oh-my-pi/pi-ai/providers/anthropic-threads";
+import type { MessageCreateParamsStreaming, MessageParam } from "@oh-my-pi/pi-ai/providers/anthropic-wire";
+
+const T0 = 1_800_000_000_000;
+
+function body(messages: MessageParam[], system = "Be brief."): MessageCreateParamsStreaming {
+	return { model: "claude-sonnet-4-6", max_tokens: 1024, stream: true, system, messages };
+}
+
+const user = (text: string): MessageParam => ({ role: "user", content: text });
+const reply = (text: string): MessageParam => ({ role: "assistant", content: [{ type: "text", text }] });
+
+/** Plan one turn of the session at `now`, report its decision, and store `stored` as its response. */
+function turn(chains: AnthropicThreadChains, params: MessageCreateParamsStreaming, now: number, stored?: MessageParam) {
+	const threadTurn = new AnthropicThreadTurn(anthropicThreadChain(chains, "session"), { resendSystemAndTools: false });
+	threadTurn.plan(params, "", now);
+	const decision = threadTurn.takeDecision();
+	threadTurn.settle(stored && { messageId: `msg_${now}`, message: stored }, now);
+	return decision;
+}
+
+/** A session whose first turn stored `reply("b")` at T0. */
+function opened(): AnthropicThreadChains {
+	const chains: AnthropicThreadChains = new Map();
+	turn(chains, body([user("a")]), T0, reply("b"));
+	return chains;
+}
+
+describe("anthropic message thread decisions", () => {
+	it("reports a create with nothing to continue, then a continue with what it appends", () => {
+		const chains: AnthropicThreadChains = new Map();
+		expect(turn(chains, body([user("a")]), T0, reply("b"))).toEqual({
+			kind: "create",
+			reason: "no-anchor",
+			messages: 1,
+		});
+		expect(turn(chains, body([user("a"), reply("b"), user("c")]), T0 + 1_000)).toEqual({
+			kind: "continue",
+			messages: 3,
+			appended: 1,
+			anchorAgeMs: 1_000,
+		});
+	});
+
+	it("reports a turn that was not stored as leaving its successor nothing to continue", () => {
+		const chains: AnthropicThreadChains = new Map();
+		turn(chains, body([user("a")]), T0);
+		expect(turn(chains, body([user("a"), reply("b"), user("c")]), T0 + 1_000)).toMatchObject({
+			kind: "create",
+			reason: "no-anchor",
+		});
+	});
+
+	it("names why a turn starts over: expired, changed fields, or diverged history", () => {
+		expect(turn(opened(), body([user("a"), reply("b"), user("c")]), T0 + 300_000)).toEqual({
+			kind: "create",
+			reason: "expired",
+			messages: 3,
+			anchorAgeMs: 300_000,
+		});
+		expect(turn(opened(), body([user("a"), reply("b"), user("c")], "Be thorough."), T0 + 1_000)).toEqual({
+			kind: "create",
+			reason: "fields-changed",
+			messages: 3,
+			anchorAgeMs: 1_000,
+			fields: ["system"],
+		});
+		expect(turn(opened(), body([user("a"), reply("edited"), user("c")]), T0 + 1_000)).toEqual({
+			kind: "create",
+			reason: "diverged",
+			messages: 3,
+			anchorAgeMs: 1_000,
+			held: 2,
+			divergedAt: 1,
+		});
+	});
+
+	it("reports a body a thread cannot hold, and each decision only once across retry rungs", () => {
+		const chains: AnthropicThreadChains = new Map();
+		const threadTurn = new AnthropicThreadTurn(anthropicThreadChain(chains, "session"), {
+			resendSystemAndTools: false,
+		});
+		const params = body([user("a")]);
+		threadTurn.plan(params, "", T0);
+		expect(threadTurn.takeDecision()).toMatchObject({ kind: "create" });
+		// A transient retry resends the same request: nothing new to report.
+		threadTurn.plan(params, "", T0);
+		expect(threadTurn.takeDecision()).toBeUndefined();
+
+		const compacting: MessageCreateParamsStreaming = { ...body([user("a")]), compaction: { type: "summarize" } };
+		threadTurn.plan(compacting, "", T0);
+		expect(threadTurn.takeDecision()).toEqual({ kind: "none", reason: "unthreadable" });
+	});
+});
