+/**
+ * How a request found its retained session state, which the gateway logs on
+ * every request: a request that finds none starts its message thread over and
+ * uploads its whole conversation, so this is what explains such an upload.
+ */
+import { describe, expect, it } from "bun:test";
+import { AuthGatewaySessionStateStore } from "@oh-my-pi/pi-ai/auth-gateway";
+import type { AuthGatewaySessionStateRequest } from "@oh-my-pi/pi-ai/auth-gateway";
+import type { Message } from "@oh-my-pi/pi-ai/types";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+
+const MODEL = buildModel({
+	id: "claude-sonnet-4-6",
+	name: "Claude Sonnet 4.6",
+	api: "anthropic-messages",
+	provider: "anthropic",
+	baseUrl: "https://api.anthropic.com",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 200_000,
+	maxTokens: 8_192,
+});
+
+function request(texts: string[], clientKey?: string): AuthGatewaySessionStateRequest {
+	const messages: Message[] = texts.map((content, index) => ({ role: "user", content, timestamp: index }));
+	return { clientKey, model: MODEL, context: { messages }, account: "credential:1" };
+}
+
+/** Acquire and release at once, returning how the request found its state. */
+function place(store: AuthGatewaySessionStateStore, req: AuthGatewaySessionStateRequest) {
+	const lease = store.acquire(req);
+	lease.release();
+	return { found: lease.found, appended: lease.appended };
+}
+
+describe("auth-gateway session state lookup", () => {
+	it("finds a keyless conversation by the history it extends, and says how far it moved on", () => {
+		const store = new AuthGatewaySessionStateStore();
+		expect(place(store, request(["a"]))).toEqual({ found: "new", appended: 0 });
+		expect(place(store, request(["a", "b", "c"]))).toEqual({ found: "history", appended: 2 });
+		// A branch that shares the opening finds nothing: the conversation it shares
+		// it with has moved on to a longer history.
+		expect(place(store, request(["a", "x"]))).toEqual({ found: "new", appended: 0 });
+	});
+
+	it("finds a conversation by the client's key", () => {
+		const store = new AuthGatewaySessionStateStore();
+		expect(place(store, request(["a"], "thread-1"))).toEqual({ found: "new", appended: 0 });
+		expect(place(store, request(["a", "b"], "thread-1"))).toEqual({ found: "client-key", appended: 0 });
+	});
+});
